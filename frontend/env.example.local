# Where the browser sends API calls. Defaults to "/api", which is rewritten
# to the backend by the Next.js dev server (see next.config.ts). Keeping it
# same-origin avoids CORS issues and works when the frontend is exposed on a
# forwarded port (e.g. localhost:3001) or behind a proxy. Override only if
# you need direct cross-origin access to the backend.
NEXT_PUBLIC_API_URL=/api

# Where the Next.js dev server proxies "/api/*" to. Read by next.config.ts
# at startup; not exposed to the browser. Defaults to http://localhost:8000.
API_PROXY_TARGET=http://localhost:8000

# Development-only: allow picking files already present on the server under
# backend/data/ (outside the uploads/ subfolder). In production builds leave
# this unset so users can only use files they upload themselves.
NEXT_PUBLIC_ALLOW_SERVER_FILES=true
